		<script>
			// The Cinecat hostname is primary; keep the existing Umami endpoint as a
			// fallback if the Cinecat analytics hostname is temporarily unavailable.
			(function () {
				const sources = [
					'https://analytics.cinecat.eu/script.js',
					'https://analytics.dulo.mov/script.js'
				];
				function load(index) {
					if (index >= sources.length) return;
					const script = document.createElement('script');
					script.async = true;
					script.src = sources[index];
					script.dataset.websiteId = '3b5b16e2-d90b-4ef4-a68d-cc8778d1b56b';
					script.onerror = () => {
						script.remove();
						load(index + 1);
					};
					document.head.appendChild(script);
				}
				load(0);
			})();
		</script>

