		<script>
			// Error reporter for browsers we cannot open a console on (old smart-TV browsers show only "500 Internal
			// Error"). Plain ES5 on purpose, and first in the page, so it works in an engine too old for the app and sees
			// errors from every script below. It sends one tiny image request per error (at most 5 per page load) to
			// /__client-error, which only exists to show up in the server's access log: message, stack, browser, page.
			(function () {
				var sent = 0;
				function report(message, stack) {
					if (sent >= 5) return;
					sent += 1;
					try {
						var q = [
							['m', String(message).slice(0, 300)],
							['s', String(stack || '').slice(0, 700)],
							['u', navigator.userAgent.slice(0, 200)],
							['p', location.pathname],
							['t', new Date().getTime()]
						]
							.map(function (kv) {
								return kv[0] + '=' + encodeURIComponent(kv[1]);
							})
							.join('&');
						new Image().src = '/__client-error?' + q;
					} catch (e) {
						/* reporting must never cause an error */
					}
				}
				window.__reportClientError = report;
				window.addEventListener('error', function (e) {
					var where = (e.filename || '').split('/').pop() + ':' + e.lineno + ':' + e.colno;
					report((e.message || 'error') + ' @' + where, e.error && e.error.stack);
				});
				window.addEventListener('unhandledrejection', function (e) {
					var r = e.reason;
					report('rejection: ' + ((r && r.message) || r), r && r.stack);
				});
			})();
		</script>
		<script>
			// Gaps in old smart-TV browsers (LG webOS 6 / NetCast report Chromium 87): the app calls these at start-up,
			// and without structuredClone the whole page died with "500 Internal Error". Plain ES5, and each one is
			// only added when the browser lacks it.
			(function () {
				var w = window;
				if (typeof w.structuredClone !== 'function') {
					w.structuredClone = function (value) {
						var seen = [];
						var copies = [];
						function clone(v) {
							if (v === null || typeof v !== 'object') return v;
							var i = seen.indexOf(v);
							if (i !== -1) return copies[i];
							var out;
							if (v instanceof Date) return new Date(v.getTime());
							if (v instanceof RegExp) return new RegExp(v.source, v.flags);
							if (v instanceof ArrayBuffer) return v.slice(0);
							if (ArrayBuffer.isView(v))
								return new v.constructor(v.buffer.slice(0), v.byteOffset, v.length);
							if (v instanceof Map) {
								out = new Map();
								seen.push(v);
								copies.push(out);
								v.forEach(function (val, key) {
									out.set(clone(key), clone(val));
								});
								return out;
							}
							if (v instanceof Set) {
								out = new Set();
								seen.push(v);
								copies.push(out);
								v.forEach(function (val) {
									out.add(clone(val));
								});
								return out;
							}
							out = Array.isArray(v) ? [] : {};
							seen.push(v);
							copies.push(out);
							Object.keys(v).forEach(function (k) {
								out[k] = clone(v[k]);
							});
							return out;
						}
						return clone(value);
					};
				}
				function addAt(proto) {
					if (proto.at) return;
					Object.defineProperty(proto, 'at', {
						configurable: true,
						writable: true,
						value: function (n) {
							n = Math.trunc(n) || 0;
							if (n < 0) n += this.length;
							return n < 0 || n >= this.length ? undefined : this[n];
						}
					});
				}
				addAt(Array.prototype);
				addAt(String.prototype);
				if (w.crypto && !w.crypto.randomUUID && w.crypto.getRandomValues) {
					w.crypto.randomUUID = function () {
						var b = w.crypto.getRandomValues(new Uint8Array(16));
						b[6] = (b[6] & 15) | 64;
						b[8] = (b[8] & 63) | 128;
						var h = Array.prototype.map
							.call(b, function (x) {
								return (x < 16 ? '0' : '') + x.toString(16);
							})
							.join('');
						return [
							h.slice(0, 8),
							h.slice(8, 12),
							h.slice(12, 16),
							h.slice(16, 20),
							h.slice(20)
						].join('-');
					};
				}
				if (w.AbortSignal && !w.AbortSignal.timeout) {
					w.AbortSignal.timeout = function (ms) {
						var c = new AbortController();
						setTimeout(function () {
							c.abort();
						}, ms);
						return c.signal;
					};
				}
			})();
		</script>
